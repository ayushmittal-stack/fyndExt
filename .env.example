# Base extension configuration (always required)
NODE_ENV=development
BACKEND_PORT=8080
EXTENSION_API_KEY=replace-with-extension-api-key
EXTENSION_API_SECRET=replace-with-extension-api-secret
EXTENSION_BASE_URL=https://extension.example.invalid
FP_API_DOMAIN=https://api.fynd.com
WEBHOOK_NOTIFICATION_EMAIL=replace-with-notification-email@example.invalid

# Shared MongoDB storage for FDK sessions, invoice state, and shipment activity.
# Replace the password placeholder with the URL-encoded Atlas database password.
MONGODB_URI=mongodb+srv://ayushmittal_db_user:<URL_ENCODED_ACTUAL_PASSWORD>@cluster0.nnmieey.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=sgh_oeis_einvoicing

# The invoice gate is disabled unless this is exactly true.
EINVOICE_ENABLED=false

# Required when the invoice gate is enabled. Exact true holds before OEIS;
# exact false permits live submission.
EINVOICE_DRY_RUN=true

# Invoice configuration (required or defaulted only when the gate is enabled)
EINVOICE_WORKER_POLL_MS=1000
EINVOICE_JOB_LEASE_MS=30000
EINVOICE_MAX_ATTEMPTS=5
EINVOICE_RETRY_BASE_MS=2000
EINVOICE_AMOUNT_TOLERANCE=0.01
EINVOICE_MASTER_DATA_PATH=./data/oeis-masters.json
EINVOICE_ALLOWED_PAYMENT_MODES=CARD,APPLE_PAY

# OEIS configuration (used only when the invoice gate is enabled)
OEIS_BASE_URL=https://oeis.example.invalid
OEIS_API_KEY=replace-with-oeis-api-key
OEIS_ALLOW_INSECURE_HTTP=false
OEIS_TIMEOUT_MS=15000
OEIS_MAX_REQUEST_BYTES=2097152
OEIS_MAX_RESPONSE_BYTES=5242880
OEIS_COMPANY_CODE=Viva Radix
OEIS_SOURCE_ERP=Fynd
OEIS_SUPPLIER_COUNTRY_CODE=SA

# OEIS_MAX_RESPONSE_BYTES must be greater than or equal to OEIS_MAX_REQUEST_BYTES.
